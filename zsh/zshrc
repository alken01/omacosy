export NVM_LAZY_LOAD=true
export NVM_DIR="$HOME/.nvm"

# Lazy load nvm
nvm() {
  unset -f nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}

[ -d /opt/homebrew/anaconda3/bin ] && export PATH="/opt/homebrew/anaconda3/bin:$PATH"

export GIT_EDITOR="subl -n -w"


# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi

# Lazy load gcloud completion
gcloud() {
    if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ] && ! complete -p gcloud &>/dev/null; then
        . "$HOME/google-cloud-sdk/completion.zsh.inc"
    fi
    command gcloud "$@"
}

autoload -U +X bashcompinit && bashcompinit
[ -x /opt/homebrew/bin/terraform ] && complete -o nospace -C /opt/homebrew/bin/terraform terraform

# Lazy load kubectl completion
kubectl() {
  if ! complete -p kubectl &>/dev/null; then
    source <(command kubectl completion zsh)
  fi
  command kubectl "$@"
}

# >>> conda initialize (lazy) >>>
# Lazy load conda
conda() {
    unset -f conda
    __conda_setup="$('/opt/homebrew/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
    if [ $? -eq 0 ]; then
        eval "$__conda_setup"
    else
        if [ -f "/opt/homebrew/anaconda3/etc/profile.d/conda.sh" ]; then
            . "/opt/homebrew/anaconda3/etc/profile.d/conda.sh"
        fi
    fi
    unset __conda_setup
    conda "$@"
}
# <<< conda initialize (lazy) <<<

brew() {
    local -a conda_envs
    while [ "${CONDA_SHLVL:-0}" -gt 0  ]; do
        conda_envs=("$CONDA_DEFAULT_ENV" $conda_envs)
        command conda deactivate
    done
    command brew $@
    local brew_status=$?
    for env in $conda_envs; do
        command conda activate "$env"
    done
    unset env
    return "$brew_status"
}

