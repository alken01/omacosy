{
  "haptic": false,
  "natural_swipe": true,
  "wrap_around": true,
  "skip_empty": false,
  "fingers": 4,
  "cursor_monitor": true,
  "swipe_left": "/opt/homebrew/bin/omniwmctl command switch-workspace next >/dev/null 2>&1",
  "swipe_right": "/opt/homebrew/bin/omniwmctl command switch-workspace prev >/dev/null 2>&1",
  "swipe_up": "/opt/homebrew/bin/omniwmctl command toggle-overview >/dev/null 2>&1",
  "swipe_down": "$HOME/.local/bin/omacosy-helper omniwm-overview-close >/dev/null 2>&1"
}