+// macOS 26.3 delivers at most one NSTouch per gesture CGEvent through an
+// event tap, so counting touches per event never reaches the configured
+// finger count. Accumulate the latest touch per finger identity instead
+// (insertion-ordered so the gesture engine's per-index prev_x/base_x
+// tracking stays coherent), dropping fingers on Ended/Cancelled or after
+// 150ms without an update.
+static NSMutableArray<id>* g_touch_order;
+static NSMutableDictionary<id, NSTouch*>* g_touch_latest;
+static NSMutableDictionary<id, NSNumber*>* g_touch_seen;
+
 static void process_touches(NSSet<NSTouch*>* touches)
 {
-	NSUInteger buf_capacity = touches.count > 0 ? touches.count : 4;
-	touch* buf = malloc(sizeof(touch) * buf_capacity);
-	NSUInteger i = 0;
+	if (!g_touch_order) {
+		g_touch_order = [NSMutableArray new];
+		g_touch_latest = [NSMutableDictionary new];
+		g_touch_seen = [NSMutableDictionary new];
+	}
 
-	for (NSTouch* touch in touches) {
-		if (touch.phase != (1 << 2)) {
-			if (i >= buf_capacity) {
-				buf_capacity *= 2;
-				buf = realloc(buf, sizeof(touch) * buf_capacity);
-			}
-			buf[i++] = [TouchConverter convert_nstouch:touch];
+	double now = CFAbsoluteTimeGetCurrent();
+
+	for (NSTouch* t in touches) {
+		id<NSCopying> ident = (id<NSCopying>)t.identity;
+		if (t.phase & (NSTouchPhaseEnded | NSTouchPhaseCancelled)) {
+			[g_touch_order removeObject:ident];
+			[g_touch_latest removeObjectForKey:ident];
+			[g_touch_seen removeObjectForKey:ident];
+		} else {
+			if (!g_touch_latest[ident])
+				[g_touch_order addObject:ident];
+			g_touch_latest[ident] = t;
+			g_touch_seen[ident] = @(now);
 		}
 	}
 
+	for (id ident in [g_touch_order copy]) {
+		if (now - [g_touch_seen[ident] doubleValue] > 0.15) {
+			[g_touch_order removeObject:ident];
+			[g_touch_latest removeObjectForKey:ident];
+			[g_touch_seen removeObjectForKey:ident];
+		}
+	}
+
+	NSUInteger n = g_touch_order.count;
+	if (!n)
+		return;
+
+	touch* buf = malloc(sizeof(touch) * n);
+	NSUInteger i = 0;
+	for (id ident in g_touch_order)
+		buf[i++] = [TouchConverter convert_nstouch:g_touch_latest[ident]];
+
 	dispatch_async(dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_DEFAULT, 0), ^{
 		gestureCallback(buf, (int)i);
 		free(buf);
