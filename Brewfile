# Window management + bar + borders
cask "aerospace"
brew "sketchybar"
brew "borders"

# CLI stack
brew "fzf"
brew "eza"
brew "zoxide"
brew "ripgrep"
brew "bat"
brew "lazygit"
brew "btop"
brew "starship"
brew "jq"

# Nerd Font for sketchybar (Korren embeds its own)
