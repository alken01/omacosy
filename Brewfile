# omacosy — everything the setup needs, installable via `brew bundle`

tap "nikitabobko/tap"        # aerospace
tap "FelixKratz/formulae"    # sketchybar, borders

# Window management + bar + borders
cask "aerospace"
cask "karabiner-elements"  # Caps Lock -> Super
brew "sketchybar"
brew "borders"

# CLI stack
brew "fzf"
brew "eza"
brew "zoxide"
brew "ripgrep"
brew "bat"
brew "lazygit"
brew "btop"
brew "starship"
brew "jq"
brew "switchaudio-osx"  # output-device switching for the bar's sound menu
brew "cliclick"             # cursor position for the popup auto-close guard
brew "blueutil"             # bluetooth control for the bar's bt menu

# Nerd Font for sketchybar (Korren embeds its own)
cask "font-jetbrains-mono-nerd-font"
