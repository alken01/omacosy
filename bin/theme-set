#!/usr/bin/env bash
# theme-set <name> — switch the whole desktop theme in one move.
# Swaps ~/.config/omarchy/current/theme (the omarchy convention), then
# nudges every consumer: Korren live-reloads on its own (it watches the
# omarchy dir), sketchybar reloads, borders restyles in place.

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"
CURRENT_DIR="$HOME/.config/omarchy/current"

case "${1:-list}" in
  list)
    for t in "$THEMES_DIR"/*/; do basename "$t"; done
    exit 0
    ;;
esac

NAME="$1"
if [ ! -d "$THEMES_DIR/$NAME" ]; then
  echo "theme-set: unknown theme '$NAME'. Available:" >&2
  for t in "$THEMES_DIR"/*/; do basename "$t"; done >&2
  exit 1
fi

# Capture the outgoing palette before the symlink moves: the bar is
# repainted slot-by-slot against it rather than rebuilt (omacosy-bar-repaint).
OLD_PALETTE=()
if [ -f "$CURRENT_DIR/theme/sketchybar.sh" ]; then
  # shellcheck source=/dev/null
  source "$CURRENT_DIR/theme/sketchybar.sh"
  for slot in ITEM_BG ACCENT LABEL_COLOR ICON_COLOR MUTED RED GREEN YELLOW BAR_BG_SOLID BAR_COLOR; do
    eval "value=\${$slot:-}"
    [ -n "$value" ] && OLD_PALETTE+=("OLD_$slot=$value")
  done
fi

mkdir -p "$CURRENT_DIR"
ln -sfn "$THEMES_DIR/$NAME" "$CURRENT_DIR/theme"

# Korren: prefer its hand-tuned built-in theme when one matches; fall
# back to live-deriving from the omarchy palette. Korren watches its
# config file, so this repaints immediately.
KORREN_CFG="$HOME/Library/Application Support/korren/config.toml"
case "$NAME" in
  tokyo-night|catppuccin|gruvbox|solarized-dark|osaka-jade|daylight) korren_theme="$NAME" ;;
  *) korren_theme="omarchy" ;;
esac
if [ -f "$KORREN_CFG" ]; then
  sed -i '' "s/^name = \".*\"/name = \"$korren_theme\"/" "$KORREN_CFG"
fi

# Wallpaper: first image in the theme's backgrounds/ dir, on every screen.
# omacosy-helper wraps NSWorkspace (System Events wallpaper scripting
# half-broke on macOS 14+: some desktops return "missing value" and
# silently keep the old picture); osascript remains as fallback.
WALL="$(ls "$THEMES_DIR/$NAME"/backgrounds/* 2>/dev/null | head -1)"
if [ -n "$WALL" ]; then
  if [ -x "$HOME/.local/bin/omacosy-helper" ]; then
    "$HOME/.local/bin/omacosy-helper" wallpaper "$WALL" >/dev/null 2>&1 || true
  else
    osascript -e "tell application \"System Events\" to tell every desktop to set picture to \"$WALL\"" >/dev/null 2>&1 || true
  fi
fi

# sketchybar: repaint the live items in one message. A full --reload
# rebuilds all 45 items in front of you and can leave the bar half-styled
# when two passes overlap, so it is only the fallback — for a first run
# with no outgoing palette, or if the repaint finds nothing to work with.
if command -v sketchybar >/dev/null; then
  repainted=0
  if [ ${#OLD_PALETTE[@]} -gt 0 ]; then
    if env "${OLD_PALETTE[@]}" "$REPO_DIR/bin/omacosy-bar-repaint"; then repainted=1; fi
  fi
  [ "$repainted" = 1 ] || sketchybar --reload || true
fi

# omacosy-borders re-reads the theme file on its own (mtime watch)

echo "theme: $NAME"
