#!/usr/bin/env bash
# Monitor-aware workspace slots: each display owns nine workspaces
# (main: 1-9, secondary: 11-19 — same LAST digit = same slot). Super+N
# acts on the focused monitor's slot N, omarchy-style.
set -euo pipefail
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"
slot="${1:-}"
op="${2:-switch}"

pick() { # monitor-id, slot -> that monitor's workspace ending in slot
  "$A" list-workspaces --monitor "$1" \
    | awk -v s="$2" 'substr($0, length($0)) == s { print; exit }'
}

# A window moved between two HIDDEN workspaces changes nothing on
# screen, so the window server has no event to give the bar and its
# workspace icons would sit stale. Builtin redirect, no extra process.
moved() { : > /tmp/omacosy-bar-moved; }

# OmniWM path: its switch-workspace / move-to-workspace already act on
# the focused monitor's numeric slot (per-monitor workspace model — no
# 11-19 twin math needed), so those route through omniwmctl. throw and
# throw-all have no slot-twin IPC equivalent — they stand down. `|| true`
# because IPC may be off; a dead key beats error spam on every press.
wm_is_omniwm() { pgrep -qf "OmniWM.app/Contents/MacOS/OmniWM"; }
if wm_is_omniwm; then
  O="$(command -v omniwmctl || echo /Applications/OmniWM.app/Contents/MacOS/omniwmctl)"
  # `omacosy-ws next` puts the direction in $slot with op defaulting to
  # switch — normalize, or the cycle logic never runs and OmniWM's own
  # walk-everything next wanders into the guest workspaces
  case "$slot" in next | prev) op="$slot" ;; esac
  # under aerospace the exec-on-workspace-change hook feeds the bar's
  # fast path; OmniWM's event stream skips EMPTY-workspace switches in
  # bursts (measured: focus-name 8/9 'executed', no event, pill stale)
  # — so every switch here feeds the same fast-path file by hand
  bar_poke() { echo "$1" > /tmp/omacosy-bar-ws 2>/dev/null || true; }
  case "$op" in
    switch)
      "$O" command switch-workspace "$slot" >/dev/null 2>&1 || true
      bar_poke "$slot" ;;
    move)
      "$O" command move-to-workspace "$slot" >/dev/null 2>&1 || true
      bar_poke "$slot" ;;
    next | prev)
      # OmniWM's own next/prev walks EVERY workspace resolved onto the
      # monitor — on one display the 14-17 guests live there too, and
      # swiping past 9 wandered into them (the same trap aerospace's
      # `workspace next` had). Cycle within the slot SET the current
      # workspace belongs to: 1-9 when on a single digit, the guest
      # set when on one of those — aerospace-era semantics exactly.
      # One query + one command, no python: the swipe->switch latency
      # IS this script (measured 215 ms with three python startups and
      # three IPC round-trips; ~80 ms now). The workspace set is static
      # config, so it comes from settings.toml instead of a query; the
      # current workspace comes from `query active-workspace` — the
      # workspaces query's isFocused goes dark on EMPTY workspaces and
      # once stranded the cycle there.
      cur="$("$O" query active-workspace 2>/dev/null | sed -n 's/.*"rawName" : "\([0-9][0-9]*\)".*/\1/p' | head -1)"
      names="$(sed -n 's/^name = "\([0-9][0-9]*\)"$/\1/p' "$HOME/.config/omniwm/settings.toml" | sort -n | tr '\n' ' ')"
      if [ -n "$cur" ] && [ -n "$names" ]; then
        # slot set: 1-9 cycles within 1-9, guests (14-17) within guests
        inset=""
        for n in $names; do
          if [ "$cur" -le 9 ]; then [ "$n" -le 9 ] && inset="$inset $n"
          else [ "$n" -gt 9 ] && inset="$inset $n"; fi
        done
        set -- $inset; count=$#; i=0; idx=0
        for n in "$@"; do [ "$n" = "$cur" ] && idx=$i; i=$((i + 1)); done
        if [ "$op" = next ]; then idx=$(( (idx + 1) % count )); else idx=$(( (idx + count - 1) % count )); fi
        shift "$idx"; cur="$1"
      else
        cur=""
      fi
      r="$("$O" workspace focus-name "$cur" 2>&1)" || true
      echo "$(date +%T) op=$op cur='$cur' resp='$(echo "$r" | head -c 120)'" >> /tmp/omacosy-ws.log
      bar_poke "$cur"
      ;;
  esac
  exit 0
fi

mon="$("$A" list-monitors --focused --format '%{monitor-id}')"
case "$op" in
  switch)
    ws="$(pick "$mon" "$slot")"
    [ -n "$ws" ] && "$A" workspace "$ws"
    ;;
  move)
    ws="$(pick "$mon" "$slot")"
    [ -n "$ws" ] && { "$A" move-node-to-workspace --focus-follows-window "$ws"; moved; }
    ;;
  next | prev) # cycle within the workspaces that BELONG to this monitor
    # `aerospace workspace next` walks every workspace on the machine, so
    # it hops monitors. Its own monitor set is not enough either: on ONE
    # display the force-assignment parks the 11-19 guests here too, and
    # cycling wandered into them (prev from 1 landed on 19). Docked, a
    # monitor's set IS its own; undocked, only the primary 1-9 are home.
    cur="$("$A" list-workspaces --focused)"
    nmon="$("$A" list-monitors | wc -l | tr -d ' ')"
    if [ "$nmon" = 1 ]; then
      all="$("$A" list-workspaces --monitor "$mon" | grep -E '^[0-9]$' | tr '\n' ' ')"
    else
      all="$("$A" list-workspaces --monitor "$mon" | tr '\n' ' ')"
    fi
    target="$(printf '%s\n' $all | awk -v cur="$cur" -v dir="$op" '
      { ws[NR] = $0 }
      END {
        if (NR == 0) exit
        at = 0
        for (i = 1; i <= NR; i++) if (ws[i] == cur) at = i
        if (at == 0) { print (dir == "prev" ? ws[NR] : ws[1]); exit }
        i = (dir == "prev") ? (at == 1 ? NR : at - 1) : (at == NR ? 1 : at + 1)
        print ws[i]
      }')"
    [ -n "$target" ] && "$A" workspace "$target"
    ;;
  throw-all) # EVERY window of the focused workspace to the twin slot
    cur="$("$A" list-workspaces --focused)"
    s="${cur: -1}"
    other="$("$A" list-monitors --format '%{monitor-id}' | grep -vx "$mon" | head -1 || true)"
    [ -n "$other" ] || exit 0
    ws="$(pick "$other" "$s")"
    [ -n "$ws" ] || exit 0
    "$A" list-windows --workspace "$cur" --format '%{window-id}' | while read -r wid; do
      [ -n "$wid" ] && "$A" move-node-to-workspace --window-id "$wid" "$ws"
    done
    moved
    "$A" workspace "$ws"
    ;;
  throw) # focused WINDOW to the same slot on the other monitor
    cur="$("$A" list-workspaces --focused)"
    s="${cur: -1}"
    other="$("$A" list-monitors --format '%{monitor-id}' | grep -vx "$mon" | head -1 || true)"
    [ -n "$other" ] || exit 0
    ws="$(pick "$other" "$s")"
    [ -n "$ws" ] && { "$A" move-node-to-workspace --focus-follows-window "$ws"; moved; }
    ;;
esac
