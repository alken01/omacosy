#!/usr/bin/env bash
# omacosy-bar-repaint — swap the bar's palette without rebuilding it.
#
# A theme switch changes ten colour values and nothing structural, so
# there is nothing to re-create: every colour is re-set on the items that
# already exist, in ONE message, and the bar changes palette in a single
# frame. `sketchybar --reload` instead re-runs the whole config — 120+
# messages, 45 item creations, every plugin re-firing — which is both slow
# enough to watch item by item and the window in which a superseded pass
# wipes --default and leaves half the bar in sketchybar's built-ins.
#
# Roles are derived by VALUE, not by item name: whatever colour an item
# wears is looked up in the outgoing palette and replaced by the same slot
# of the incoming one, so items added later are covered without a list
# here to forget them in. theme-set hands the outgoing palette over as
# OLD_<SLOT>; without it there is nothing to map from, so we fail and let
# the caller fall back to a reload.
export PATH="/opt/homebrew/bin:$PATH"
set -uo pipefail

command -v sketchybar >/dev/null || exit 1
source "$HOME/.config/omarchy/current/theme/sketchybar.sh" 2>/dev/null || exit 1

# ICON_COLOR and LABEL_COLOR hold the same value in every theme we ship;
# should one ever split them, the first slot listed wins the substitution.
SLOTS="ITEM_BG ACCENT LABEL_COLOR ICON_COLOR MUTED RED GREEN YELLOW BAR_BG_SOLID BAR_COLOR"

MAP=""
for slot in $SLOTS; do
  eval "from=\${OLD_$slot:-}"
  eval "to=\${$slot:-}"
  [ -n "$from" ] && [ -n "$to" ] && [ "$from" != "$to" ] && MAP="$MAP $from=$to"
done
[ -n "$MAP" ] || exit 0 # same palette, nothing to repaint

ITEMS="$(sketchybar --query bar | jq -r '.items[]' 2>/dev/null)" || exit 1
[ -n "$ITEMS" ] || exit 1

QUERY=()
for it in $ITEMS; do QUERY+=(--query "$it"); done

# Every colour-valued leaf of every item, with the path that names it.
# --query reports item geometry nested but sketchybar sets it flat, so
# geometry.background.color goes back as background.color.
REPAINT=()
CURRENT=""
props=()
while IFS=$'\t' read -r name path value; do
  [ -n "$name" ] || continue
  if [ "$name" != "$CURRENT" ]; then
    [ ${#props[@]} -gt 0 ] && REPAINT+=(--set "$CURRENT" "${props[@]}")
    CURRENT="$name"
    props=()
  fi
  for pair in $MAP; do
    case "$pair" in "$value="*)
      props+=("${path#geometry.}=${pair#*=}")
      break
      ;;
    esac
  done
done <<EOF
$(sketchybar "${QUERY[@]}" | jq -r '.name as $n
  | paths(type == "string" and test("^0x[0-9a-fA-F]+$")) as $p
  | [$n, ($p | join(".")), getpath($p)] | @tsv')
EOF
[ -n "$CURRENT" ] && [ ${#props[@]} -gt 0 ] && REPAINT+=(--set "$CURRENT" "${props[@]}")

# Popup colours are the one thing --query does not report, so they are
# re-stated rather than mapped; on an item without a popup they simply sit
# there. The default template gets the new palette too, so popup children
# built after this point are born in the right colours.
for it in $ITEMS; do
  REPAINT+=(--set "$it" popup.background.color="$BAR_BG_SOLID" popup.background.border_color="$ACCENT")
done
REPAINT+=(--default icon.color="$ICON_COLOR" label.color="$LABEL_COLOR")

sketchybar "${REPAINT[@]}"
