#!/usr/bin/env bash
# omacosy-float — surface the floating windows of the focused workspace.
#
# Floating windows sink behind tiles and there is no fixing that from up
# here: macOS orders windows per APP, not per window, so a float can only
# sit above another app's window while its own app is frontmost. Pinning
# it would mean rewriting the window's level through a private SkyLight
# call, which needs SIP disabled — not a trade this project makes.
#
# So retrieval replaces persistence: each press focuses the next float on
# the workspace, wrapping, and brings the cursor with it. The cursor move
# is not a nicety — focus-follows-mouse would hand focus straight back to
# whatever tile the pointer was still resting on.
set -uo pipefail
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"

FLOATS="$("$A" list-windows --workspace focused --format '%{window-id}|%{window-layout}' 2>/dev/null |
  awk -F'|' '$2 == "floating" { print $1 }')"
if [ -z "$FLOATS" ]; then
  # nothing to surface — and if the bar still shows a float pill it is
  # holding a count that aerospace no longer agrees with (its window list
  # can lag a destroy past the event that prompted the last count), so
  # take the chance to put it right
  sketchybar --trigger windows_changed 2>/dev/null || true
  exit 0
fi

CURRENT="$("$A" list-windows --focused --format '%{window-id}' 2>/dev/null || true)"

# the one after the focused float, or the first when focus is on a tile
first=""
armed=0
next=""
for id in $FLOATS; do
  [ -n "$first" ] || first="$id"
  if [ "$armed" = 1 ]; then
    next="$id"
    break
  fi
  [ "$id" = "$CURRENT" ] && armed=1
done
[ -n "$next" ] || next="$first"

"$A" focus --window-id "$next" || exit 0
"$A" move-mouse window-lazy-center >/dev/null 2>&1 || true
