#!/usr/bin/env bash
# theme-next — cycle to the next theme (bound to ctrl+alt+shift+space).

set -euo pipefail
# resolve through the ~/.local/bin symlink to the real repo
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
THEMES_DIR="$REPO_DIR/themes"

themes=()
for t in "$THEMES_DIR"/*/; do themes+=("$(basename "$t")"); done

current="$(basename "$(readlink "$HOME/.config/omarchy/current/theme" 2>/dev/null || echo "${themes[0]}")")"

next="${themes[0]}"
for i in "${!themes[@]}"; do
  if [ "${themes[$i]}" = "$current" ]; then
    next="${themes[$(( (i + 1) % ${#themes[@]} ))]}"
    break
  fi
done

exec "$REPO_DIR/bin/theme-set" "$next"
