#!/usr/bin/env bash
# omacosy-layout <resize <±N>|togglesplit> — Super+-/=/J, wrapper-aware.
#
# The dwindle split hint pre-splits the focused window so the NEXT
# window lands in the right half (see helper/main.swift split-hint).
# AeroSpace's `split` does that by wrapping the window in a solo
# container — and every parent-targeting command then resolves against
# that wrapper: `resize smart` finds no sibling and no-ops (issue #3),
# and `layout tiles horizontal vertical` silently flips the preset
# split direction with nothing visible. Measured on 0.21.3-Beta:
# smart/smart-opposite/height all rc=2 no-ops in the wrapper state;
# `resize width` correctly trades space through it when the real
# neighbor is horizontal.
set -uo pipefail
A="$(command -v aerospace || echo /opt/homebrew/bin/aerospace)"

case "${1:-}" in
resize)
  N="${2:?usage: omacosy-layout resize <+N|-N>}"
  # smart covers the unwrapped case; in the wrapper the working axis
  # is whichever one has a real neighbor — try width, then height.
  # no `--`: AeroSpace's parser treats it as an unknown argument
  "$A" resize smart "$N" 2>/dev/null && exit 0
  "$A" resize width "$N" 2>/dev/null && exit 0
  exec "$A" resize height "$N" 2>/dev/null
  ;;
togglesplit)
  # Toggling inside the wrapper flips the NEXT spawn's direction
  # invisibly instead of the visible pair. Dissolve the wrapper first
  # (floating->tiling is the only dissolve AeroSpace offers; it may
  # reinsert on the other side, which is acceptable here — J is a
  # layout mutation, the user expects windows to move). Only dance
  # when the split hint says the focused window is the one it wrapped,
  # so an unwrapped or floating window never gets kicked around.
  STATE="/tmp/omacosy-split-state-$(id -u)"
  WID="$("$A" list-windows --focused --format '%{window-id}' 2>/dev/null)"
  if [ -f "$STATE" ] && [ "$(cut -d' ' -f1 "$STATE")" = "$WID" ]; then
    "$A" layout floating 2>/dev/null
    "$A" layout tiling 2>/dev/null
  fi
  exec "$A" layout tiles horizontal vertical
  ;;
*)
  echo "usage: omacosy-layout <resize <±N>|togglesplit>" >&2
  exit 1
  ;;
esac
